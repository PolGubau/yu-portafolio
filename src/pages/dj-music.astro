---
import BaseLayout from "../layouts/BaseLayout.astro";
import eventsData from "../content/events.json";
import Photo from "../components/Photo.astro";

import { djMusic, contact, pageTitle } from "../content/site";
// The first event of events.json is highlighted; the rest go in the list.
const [featured, ...rest] = eventsData as {
	name: string;
	location: string;
	genres: string;
	type: string;
	date: string;
	photo?: string;
}[];
const gallery = djMusic.gallery;
---

<BaseLayout title={pageTitle(djMusic.title)} description={djMusic.description}>
	<main class="page-shell music-page">
		<section class="music-copy">
			<h1><a href="/">{djMusic.heading}</a></h1>
			<div class="music-links">
				<span>
					<strong>{djMusic.linkLabels.sets}</strong><a
						href={contact.soundcloud.url}
						target="_blank"
						rel="noreferrer">{contact.soundcloud.url}</a
					>
				</span>
				<span
					><strong>{djMusic.linkLabels.contact}</strong><a
						href={`mailto:${contact.email}`}>{contact.email}</a
					></span
				>
				<span>
					<strong>{djMusic.linkLabels.instagram}</strong>
					<a href={contact.instagram.url} target="_blank" rel="noreferrer"
						>{contact.instagram.handle}</a
					>
				</span>
			</div>
			<h2 class="events-title">{djMusic.eventsHeading}</h2>
			{
				featured && (
					<article class="event-featured">
						{featured.photo && (
							<Photo
								src={featured.photo}
								alt={featured.name}
								sizes="(min-width: 700px) 260px, 100vw"
								widths={[400, 700, 1000]}
								priority
							/>
						)}
						<div class="event-featured-body">
							<span class="event-featured-date">{featured.date}</span>
							<h3>{featured.name}</h3>
							<p class="event-featured-place">{featured.location}</p>
							<p class="event-tags">
								<span>{featured.type}</span>
								<span>{featured.genres}</span>
							</p>
						</div>
					</article>
				)
			}
			<table class="events-table">
				<thead
					><tr>{djMusic.eventsColumns.map((column) => <th>{column}</th>)}</tr
					></thead
				>
				<tbody
					>{
						rest.map((e) => (
							<tr>
								<td>{e.name}</td>
								<td>{e.location}</td>
								<td>{e.genres}</td>
								<td>{e.type}</td>
								<td>{e.date}</td>
							</tr>
						))
					}</tbody
				>
			</table>
			<ul class="events-cards">
				{
					rest.map((e) => (
						<li>
							<div class="event-card-head">
								<strong>{e.name}</strong>
								<span>{e.date}</span>
							</div>
							<p class="event-card-place">{e.location}</p>
							<p class="event-tags">
								<span>{e.type}</span>
								<span>{e.genres}</span>
							</p>
						</li>
					))
				}
			</ul>
		</section>
		<aside class="music-gallery" aria-label={djMusic.galleryLabel}>
			{
				gallery.map((image, index) => (
					<Photo
						src={image}
						alt={`${djMusic.photoAlt} - ${index + 1}`}
						sizes="100vw"
						widths={[400, 700, 1000, 1400, 1800, 2400]}
						zoom
					/>
				))
			}
		</aside>
	</main>
</BaseLayout>
