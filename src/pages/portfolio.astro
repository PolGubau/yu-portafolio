---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../content/projects";
import Photo from "../components/Photo.astro";
import { portfolio, pageTitle } from "../content/site";
---

<BaseLayout
	title={pageTitle(portfolio.title)}
	description={portfolio.description}
>
	<main class="page-shell portfolio-page">
		<div class="project-grid">
			{
				projects.map((project, index) => (
					<article class="project-card">
						<a class="project-card-main" href={`/${project.slug}`}>
							<Photo
								src={project.thumbnail}
								alt=""
								sizes="(min-width: 700px) 50vw, 100vw"
								widths={[400, 700, 1000]}
								priority={index < 2}
							/>
							<span>{project.title.toLowerCase()}</span>
						</a>
						<span class="project-card-tag">
							{project.category.toLowerCase()}
						</span>
					</article>
				))
			}
		</div>
	</main>
</BaseLayout>
